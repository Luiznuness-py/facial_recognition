# Demonstração local. Copie para .env.demo e configure um banco PostgreSQL separado.
# O arquivo .env.demo é privado e ignorado pelo Git.
APP_NAME='Laboratório de Biossegurança Ambiental - demonstração'
ENVIRONMENT=development
BIOMETRICS_MODE=simulated
DEBUG=false
DATABASE_ECHO=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD='configure-a-senha-do-postgres-local'
DB_NAME=facial_demo

# Gere uma chave local nova; não reutilize a chave de outro ambiente.
SECRET_KEY='substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres'
ADMIN_EMAIL=admin.demo@example.com
ADMIN_SECRET='Temporary!Demo2026'

# Senha definida na preparação das contas desta demonstração, não lida pela API.
# Alterar esta variável não redefine senhas já gravadas no banco.
DEMO_PASSWORD='Visual!Demo2026'
